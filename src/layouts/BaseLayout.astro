---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import SearchModal from "../components/SearchModal.astro";
import { withBase } from "../lib/url";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article" | "profile";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogType, structuredData } = Astro.props;
---

<!doctype html>
<html lang="tr">
  <head>
    <BaseHead title={title} description={description} ogType={ogType} structuredData={structuredData} />
  </head>
  <body class="flex min-h-screen flex-col">
    <Header />
    <main class="flex-1">
      <slot />
    </main>
    <div class="mx-auto max-w-3xl border-t border-rule px-5 py-8">
      <p class="text-sm text-ink-soft">
        Kitaplar, alıntılar, incelemeler, notları ve blog yazılarının tamamını tek bir zaman akışında görmek için{" "}
        <a href={withBase("/arsiv/")} class="font-semibold text-leather hover:underline">arşive</a> göz atabilirsiniz.
      </p>
    </div>
    <Footer />
    <SearchModal />
  </body>
</html>
