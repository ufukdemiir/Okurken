---
import { getEntry } from "astro:content";
import { withBase } from "../lib/url";

interface Props {
  title: string;
  description: string;
  ogType?: "website" | "article" | "profile";
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, ogType = "website", structuredData } = Astro.props;

const settings = await getEntry("settings", "main");
const readerName = settings?.data.readerName ?? "Ufuk Demir";

const siteName = "Okurken";
const fullTitle = title === siteName ? siteName : `${title} · ${siteName}`;
const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const personSchema = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: readerName,
  url: Astro.site?.toString(),
  description: settings?.data.tagline,
};

const websiteSchema = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: siteName,
  url: Astro.site?.toString(),
  description: settings?.data.siteDescription,
  author: { "@type": "Person", name: readerName },
  inLanguage: "tr-TR",
};

const extraSchemas = structuredData
  ? Array.isArray(structuredData)
    ? structuredData
    : [structuredData]
  : [];
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="generator" content={Astro.generator} />
<link rel="icon" type="image/svg+xml" href={withBase("/favicon.svg")} />
<link rel="sitemap" href={withBase("/sitemap-index.xml")} />
<link rel="canonical" href={canonicalURL} />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<meta name="author" content={readerName} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content={ogType} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:site_name" content={siteName} />
<meta property="og:locale" content="tr_TR" />

<!-- Twitter -->
<meta name="twitter:card" content="summary" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />

<!-- Fontlar: Source Serif 4 (okuma metinleri) + Plus Jakarta Sans (arayüz) -->
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link
  rel="stylesheet"
  href="https://fonts.googleapis.com/css2?family=Source+Serif+4:ital,opsz,wght@0,8..60,400;0,8..60,600;0,8..60,700;1,8..60,400&family=Plus+Jakarta+Sans:wght@400;500;600;700&display=swap"
/>

<script is:inline define:vars={{ storageKey: "okurken-theme" }}>
  // Koyu/aydınlık mod tercihini sayfa boyanmadan ÖNCE uygula (FOUC engelleme).
  (function () {
    try {
      const stored = localStorage.getItem(storageKey);
      const prefersDark = window.matchMedia("(prefers-color-scheme: dark)").matches;
      const isDark = stored ? stored === "dark" : prefersDark;
      document.documentElement.classList.toggle("dark", isDark);
    } catch (_) {
      /* localStorage erişilemezse aydınlık moda düşülür */
    }
  })();
</script>

<script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
<script type="application/ld+json" set:html={JSON.stringify(websiteSchema)} />
{
  extraSchemas.map((schema) => (
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  ))
}
