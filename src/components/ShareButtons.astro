---
interface Props {
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className = "" } = Astro.props;
const whatsappHref = `https://wa.me/?text=${encodeURIComponent(`${title} — ${url}`)}`;
const xHref = `https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(url)}`;
---

<div class={`flex flex-wrap items-center gap-2 ${className}`}>
  <a
    href={xHref}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 rounded-full border border-rule px-3 py-1.5 text-sm text-ink-soft transition-colors hover:border-leather hover:text-leather"
  >
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
      <path d="M7 17 17 7M9 7h8v8"></path>
    </svg>
    X'te paylaş
  </a>
  <a
    href={whatsappHref}
    target="_blank"
    rel="noopener noreferrer"
    class="inline-flex items-center gap-1.5 rounded-full border border-rule px-3 py-1.5 text-sm text-ink-soft transition-colors hover:border-leather hover:text-leather"
  >
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M4 20l1.3-3.9A7.5 7.5 0 1 1 8.9 19L4 20Z"></path>
    </svg>
    WhatsApp'ta paylaş
  </a>
  <button
    type="button"
    data-copy-url={url}
    class="copy-link-btn inline-flex items-center gap-1.5 rounded-full border border-rule px-3 py-1.5 text-sm text-ink-soft transition-colors hover:border-leather hover:text-leather"
  >
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <rect x="9" y="9" width="11" height="11" rx="1.5"></rect>
      <path d="M5 15V5a1 1 0 0 1 1-1h10"></path>
    </svg>
    <span class="copy-link-label">Linki kopyala</span>
  </button>
</div>

<script>
  // Aynı sayfada birden fazla ShareButtons örneği olabileceği için
  // tek bir olay temsilcisi (event delegation) kullanılır.
  if (!(window as any).__okurkenCopyBound) {
    (window as any).__okurkenCopyBound = true;
    document.addEventListener("click", async (event) => {
      const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>(
        "[data-copy-url]",
      );
      if (!button) return;
      const url = button.getAttribute("data-copy-url");
      if (!url) return;
      try {
        await navigator.clipboard.writeText(url);
        const label = button.querySelector(".copy-link-label");
        if (label) {
          const original = label.textContent;
          label.textContent = "Kopyalandı!";
          setTimeout(() => {
            label.textContent = original;
          }, 1800);
        }
      } catch (_) {
        /* Panoya erişim reddedilmiş olabilir; sessizce yoksay. */
      }
    });
  }
</script>
