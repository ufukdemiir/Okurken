---
interface Props {
  url: string;
  title: string;
  class?: string;
}

const { url, title, class: className = "" } = Astro.props;
const encodedUrl = encodeURIComponent(url);
const encodedTitle = encodeURIComponent(title);

// Sıra kasıtlı: X, Facebook, LinkedIn, Pinterest, Tumblr, Telegram, WhatsApp.
const shareLinks = [
  { label: "X", href: `https://twitter.com/intent/tweet?text=${encodedTitle}&url=${encodedUrl}` },
  { label: "Facebook", href: `https://www.facebook.com/sharer.php?u=${encodedUrl}` },
  { label: "LinkedIn", href: `https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}` },
  {
    label: "Pinterest",
    href: `https://pinterest.com/pin/create/button/?url=${encodedUrl}&description=${encodedTitle}`,
  },
  {
    label: "Tumblr",
    href: `https://www.tumblr.com/widgets/share/tool?canonicalUrl=${encodedUrl}&title=${encodedTitle}`,
  },
  { label: "Telegram", href: `https://t.me/share/url?url=${encodedUrl}&text=${encodedTitle}` },
  {
    label: "WhatsApp",
    href: `https://wa.me/?text=${encodeURIComponent(`${title} — ${url}`)}`,
  },
];
---

<details class={`share-menu relative inline-block ${className}`}>
  <summary
    class="flex list-none cursor-pointer select-none items-center gap-1.5 rounded-full border border-rule px-3 py-1.5 text-sm text-ink-soft transition-colors hover:border-leather hover:text-leather [&::-webkit-details-marker]:hidden"
  >
    <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
      <path d="M12 15V4M8 8l4-4 4 4" />
      <path d="M5 13v5a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-5" />
    </svg>
    Paylaş
  </summary>
  <div class="absolute left-0 top-9 z-10 flex w-48 flex-col rounded-lg border border-rule bg-surface p-1.5 shadow-lg">
    {
      shareLinks.map((link) => (
        <a
          href={link.href}
          target="_blank"
          rel="noopener noreferrer"
          class="rounded-md px-3 py-2 text-sm text-ink-soft hover:bg-paper hover:text-leather"
        >
          {link.label}
        </a>
      ))
    }
    <button
      type="button"
      data-copy-url={url}
      class="copy-link-btn rounded-md px-3 py-2 text-left text-sm text-ink-soft hover:bg-paper hover:text-leather"
    >
      <span class="copy-link-label">Bağlantıyı kopyala</span>
    </button>
  </div>
</details>

<script>
  // Aynı sayfada onlarca ShareButtons örneği olabilir (her alıntı/not için
  // bir tane); bu yüzden tek bir olay temsilcisi kullanılır.
  if (!(window as any).__okurkenShareBound) {
    (window as any).__okurkenShareBound = true;

    document.addEventListener("click", async (event) => {
      const target = event.target as HTMLElement;

      // Panoya kopyala
      const copyButton = target.closest<HTMLButtonElement>("[data-copy-url]");
      if (copyButton) {
        const url = copyButton.getAttribute("data-copy-url");
        if (url) {
          try {
            await navigator.clipboard.writeText(url);
            const label = copyButton.querySelector(".copy-link-label");
            if (label) {
              const original = label.textContent;
              label.textContent = "Kopyalandı!";
              setTimeout(() => {
                label.textContent = original;
              }, 1800);
            }
          } catch (_) {
            /* Panoya erişim reddedilmiş olabilir; sessizce yoksay. */
          }
        }
      }

      // Açık menüleri, dışarı tıklandığında kapat.
      document.querySelectorAll("details.share-menu[open]").forEach((menu) => {
        if (!menu.contains(target)) {
          menu.removeAttribute("open");
        }
      });
    });
  }
</script>
