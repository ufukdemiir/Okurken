---
import { getEntry } from "astro:content";
import { getFinishedCountForYear } from "../lib/books";

const settings = await getEntry("settings", "main");
const goalYear = settings?.data.goalYear ?? new Date().getFullYear();
const yearlyGoal = settings?.data.yearlyGoal ?? 0;
const finished = await getFinishedCountForYear(goalYear);
const percent = yearlyGoal > 0 ? Math.min(100, Math.round((finished / yearlyGoal) * 100)) : 0;
---

<div class="rounded-xl border border-rule bg-surface p-5">
  <div class="flex items-baseline justify-between gap-3">
    <h2 class="font-serif text-lg text-ink">{goalYear} okuma hedefi</h2>
    <span class="shrink-0 text-sm text-ink-soft">{finished}/{yearlyGoal} kitap</span>
  </div>
  <div class="mt-3 h-2 overflow-hidden rounded-full bg-rule" role="progressbar" aria-valuenow={percent} aria-valuemin={0} aria-valuemax={100}>
    <div class="h-full rounded-full bg-leather transition-[width] duration-500" style={`width:${percent}%`}></div>
  </div>
  <p class="mt-2 text-sm text-ink-soft">%{percent} tamamlandı</p>
</div>
