---
import { getEntry } from "astro:content";
import { withBase } from "../lib/url";
import ExportDataButton from "./ExportDataButton.astro";

const settings = await getEntry("settings", "main");
const social = settings?.data.social;
const readerName = settings?.data.readerName ?? "Ufuk Demir";
const foundingYear = settings?.data.foundingYear ?? new Date().getFullYear();
const currentYear = new Date().getFullYear();
const yearLabel = currentYear > foundingYear ? `${foundingYear}–${currentYear}` : String(foundingYear);

// GitHub/LinkedIn/Pinterest ana sayfadaki okur kartında buton olarak
// gösteriliyor; burada yalnızca genel amaçlı bağlantılar kalıyor.
const links = [
  { href: social?.website, label: "Web sitesi" },
  { href: social?.email && `mailto:${social.email}`, label: "E-posta" },
].filter((l): l is { href: string; label: string } => Boolean(l.href));
---

<footer class="border-t border-rule">
  <div class="mx-auto flex max-w-5xl flex-col gap-4 px-5 py-8 sm:flex-row sm:items-center sm:justify-between">
    <p class="font-serif text-sm text-ink-soft">
      © {yearLabel} Okurken — {readerName}. Tüm hakları saklıdır.
    </p>

    {
      links.length > 0 && (
        <nav class="flex flex-wrap gap-x-4 gap-y-1" aria-label="Sosyal bağlantılar">
          {links.map((link) => (
            <a
              href={link.href}
              target={link.href.startsWith("mailto:") ? undefined : "_blank"}
              rel="noopener noreferrer"
              class="text-sm text-ink-soft transition-colors hover:text-leather"
            >
              {link.label}
            </a>
          ))}
        </nav>
      )
    }
  </div>
  <div class="mx-auto flex max-w-5xl flex-wrap items-center gap-x-4 gap-y-2 px-5 pb-8">
    <a href={withBase("/admin/")} class="text-xs text-ink-soft/70 hover:text-leather">
      Yönetim paneli
    </a>
    <ExportDataButton variant="link" />
  </div>
</footer>
