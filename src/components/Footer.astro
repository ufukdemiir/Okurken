---
import { getEntry } from "astro:content";
import { withBase } from "../lib/url";
import ExportDataButton from "./ExportDataButton.astro";

const settings = await getEntry("settings", "main");
const social = settings?.data.social;
const readerName = settings?.data.readerName ?? "Ufuk Demir";
const foundingYear = settings?.data.foundingYear ?? new Date().getFullYear();
const currentYear = new Date().getFullYear();
const yearLabel = currentYear > foundingYear ? `${foundingYear}–${currentYear}` : String(foundingYear);

// GitHub/LinkedIn/Pinterest ana sayfadaki okur kartında buton olarak
// gösteriliyor; burada yalnızca genel amaçlı bağlantılar kalıyor.
const links = [
  { href: social?.website, label: "Web sitesi" },
  { href: social?.email && `mailto:${social.email}`, label: "E-posta" },
].filter((l): l is { href: string; label: string } => Boolean(l.href));
---

<footer class="border-t border-rule">
  <div class="mx-auto flex max-w-3xl flex-col items-center gap-4 px-5 py-10 text-center">
    <nav class="flex flex-wrap items-center justify-center gap-x-5 gap-y-2 text-sm text-ink-soft" aria-label="Site bağlantıları">
      <a href={withBase("/admin/")} class="hover:text-leather">Yönetim paneli</a>
      <ExportDataButton variant="link" />
      {links.map((link) => (
        <a
          href={link.href}
          target={link.href.startsWith("mailto:") ? undefined : "_blank"}
          rel="noopener noreferrer"
          class="transition-colors hover:text-leather"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <p class="text-xs text-ink-soft/60">
      © {yearLabel} Okurken, {readerName}. Tüm hakları saklıdır.
    </p>
  </div>
</footer>
