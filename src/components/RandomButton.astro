---
import { getPublishedBooks, getAllQuotes, getAllNotes, getBooksWithReviews } from "../lib/books";

interface Props {
  kind: "book" | "quote" | "review" | "note";
  class?: string;
}

const { kind, class: className = "" } = Astro.props;

const LABELS: Record<Props["kind"], string> = {
  book: "Rastgele kitap",
  quote: "Rastgele alıntı",
  review: "Rastgele inceleme",
  note: "Rastgele not",
};

let pool: string[] = [];
switch (kind) {
  case "book": {
    const books = await getPublishedBooks();
    pool = books.map((b) => `/kitaplar/${b.id}/`);
    break;
  }
  case "quote": {
    const quotes = await getAllQuotes();
    pool = quotes.map((q) => `/kitaplar/${q.book.id}/#alinti-${q.index}`);
    break;
  }
  case "review": {
    const reviews = await getBooksWithReviews();
    pool = reviews.map((b) => `/kitaplar/${b.id}/#inceleme`);
    break;
  }
  case "note": {
    const notes = await getAllNotes();
    pool = notes.map((n) => `/kitaplar/${n.book.id}/#not-${n.index}`);
    break;
  }
}
---

{
  pool.length > 0 && (
    <button
      type="button"
      data-random-pool={JSON.stringify(pool)}
      class={`inline-flex items-center gap-2 rounded-full border border-rule px-4 py-2 text-sm text-ink-soft transition-colors hover:border-leather hover:text-leather ${className}`}
    >
      <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
        <rect x="4" y="4" width="16" height="16" rx="3" />
        <circle cx="8.5" cy="8.5" r="1" fill="currentColor" stroke="none" />
        <circle cx="15.5" cy="8.5" r="1" fill="currentColor" stroke="none" />
        <circle cx="12" cy="12" r="1" fill="currentColor" stroke="none" />
        <circle cx="8.5" cy="15.5" r="1" fill="currentColor" stroke="none" />
        <circle cx="15.5" cy="15.5" r="1" fill="currentColor" stroke="none" />
      </svg>
      {LABELS[kind]}
    </button>
  )
}

<script>
  // Sayfada birden fazla "Rastgele ..." butonu olabileceği için tek bir
  // olay temsilcisi (event delegation) kullanılır.
  if (!(window as any).__okurkenRandomBound) {
    (window as any).__okurkenRandomBound = true;
    document.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>("[data-random-pool]");
      if (!button) return;
      const pool: string[] = JSON.parse(button.getAttribute("data-random-pool") ?? "[]");
      if (!pool.length) return;
      const choice = pool[Math.floor(Math.random() * pool.length)];
      const base = import.meta.env.BASE_URL.endsWith("/")
        ? import.meta.env.BASE_URL.slice(0, -1)
        : import.meta.env.BASE_URL;
      window.location.href = `${base}${choice}`;
    });
  }
</script>
