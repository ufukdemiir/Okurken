---
import { getPublishedBooks, getAllQuotes, getAllNotes, getBooksWithReviews } from "../lib/books";
import { getPublishedPosts } from "../lib/blog";

interface Props {
  kind: "book" | "quote" | "review" | "note" | "blog";
  class?: string;
}

const { kind, class: className = "" } = Astro.props;

const LABELS: Record<Props["kind"], string> = {
  book: "Rastgele kitap",
  quote: "Rastgele alıntı",
  review: "Rastgele inceleme",
  note: "Rastgele not",
  blog: "Rastgele blog yazısı",
};

// Her buton için farklı, tamamen jenerik (telif sorunu olmayan) bir ikon.
const ICON_PATHS: Record<Props["kind"], string> = {
  // Açık kitap
  book: '<path d="M3 5c2-1 5-1 7 1v12c-2-2-5-2-7-1V5Z"/><path d="M21 5c-2-1-5-1-7 1v12c2-2 5-2 7-1V5Z"/>',
  // Tırnak işareti
  quote:
    '<path d="M7 8c-2 0-3.3 1.4-3.3 3.4S5 14.7 7 14.7c0 1.9-1 2.9-3 2.9"/><path d="M16.5 8c-2 0-3.3 1.4-3.3 3.4s1.3 3.3 3.3 3.3c0 1.9-1 2.9-3 2.9"/>',
  // Yıldız
  review: '<path d="m12 3 2.5 5.6 6.1.6-4.6 4.1 1.3 6-5.3-3.1-5.3 3.1 1.3-6-4.6-4.1 6.1-.6L12 3Z"/>',
  // Yer imi / not
  note: '<path d="M6 3h12v18l-6-4-6 4V3Z"/>',
  // Makale/blog yazısı
  blog: '<rect x="4" y="3" width="16" height="18" rx="1.5"/><path d="M8 8h8M8 12h8M8 16h5"/>',
};

let pool: string[] = [];
switch (kind) {
  case "book": {
    const books = await getPublishedBooks();
    pool = books.map((b) => `/kitaplar/${b.id}/`);
    break;
  }
  case "quote": {
    const quotes = await getAllQuotes();
    pool = quotes.map((q) => `/kitaplar/${q.book.id}/#alinti-${q.index}`);
    break;
  }
  case "review": {
    const reviews = await getBooksWithReviews();
    pool = reviews.map((b) => `/kitaplar/${b.id}/#inceleme`);
    break;
  }
  case "note": {
    const notes = await getAllNotes();
    pool = notes.map((n) => `/kitaplar/${n.book.id}/#not-${n.index}`);
    break;
  }
  case "blog": {
    const posts = await getPublishedPosts();
    pool = posts.map((p) => `/blog/${p.id}/`);
    break;
  }
}
---

{
  pool.length > 0 && (
    <button
      type="button"
      data-random-pool={JSON.stringify(pool)}
      class={`inline-flex items-center gap-1.5 rounded-full bg-ink px-3 py-1.5 text-xs text-paper transition-opacity hover:opacity-85 ${className}`}
    >
      <svg
        class="size-3.5 shrink-0"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        set:html={ICON_PATHS[kind]}
      />
      {LABELS[kind]}
    </button>
  )
}

<script>
  // Sayfada birden fazla "Rastgele ..." butonu olabileceği için tek bir
  // olay temsilcisi (event delegation) kullanılır.
  if (!(window as any).__okurkenRandomBound) {
    (window as any).__okurkenRandomBound = true;
    document.addEventListener("click", (event) => {
      const button = (event.target as HTMLElement)?.closest<HTMLButtonElement>("[data-random-pool]");
      if (!button) return;
      const pool: string[] = JSON.parse(button.getAttribute("data-random-pool") ?? "[]");
      if (!pool.length) return;
      const choice = pool[Math.floor(Math.random() * pool.length)];
      const base = import.meta.env.BASE_URL.endsWith("/")
        ? import.meta.env.BASE_URL.slice(0, -1)
        : import.meta.env.BASE_URL;
      window.location.href = `${base}${choice}`;
    });
  }
</script>
