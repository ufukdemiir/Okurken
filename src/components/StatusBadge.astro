---
import { STATUS_LABELS_TR, type BookEntry } from "../lib/books";
import { getStatusColorVar } from "../lib/status";

interface Props {
  status: BookEntry["data"]["status"];
  class?: string;
}

const { status, class: className = "" } = Astro.props;
const colorVar = getStatusColorVar(status);
const label = STATUS_LABELS_TR[status];
---

<span class={`inline-flex items-center gap-1.5 text-sm text-ink-soft ${className}`}>
  <span
    class="size-1.5 shrink-0 rounded-full"
    style={`background-color: var(${colorVar})`}
    aria-hidden="true"
  ></span>
  {label}
</span>
