---
import BaseLayout from "../layouts/BaseLayout.astro";
import ShareButtons from "../components/ShareButtons.astro";
import { getAllQuotes } from "../lib/books";
import { withBase } from "../lib/url";

const quotes = await getAllQuotes();
---

<BaseLayout title="Alıntılar" description="Okunan kitaplardan seçilen tüm alıntıların yer aldığı akış.">
  <div class="mx-auto max-w-3xl px-5 py-10">
    <h1 class="font-serif text-3xl text-ink">Alıntılar</h1>
    <p class="mt-2 text-ink-soft">Toplam {quotes.length} alıntı.</p>

    {quotes.length === 0 && <p class="mt-8 text-ink-soft">Henüz eklenmiş bir alıntı yok.</p>}

    <ul class="mt-8 flex flex-col gap-8">
      {
        quotes.map((quote) => {
          const relativeUrl = `/kitaplar/${quote.book.id}/#alinti-${quote.index}`;
          const absoluteUrl = new URL(withBase(relativeUrl), Astro.site).toString();
          return (
            <li id={`alinti-${quote.book.id}-${quote.index}`} class="scroll-mt-24 border-l-2 border-gold pl-4">
              <a href={withBase(relativeUrl)} class="group block">
                <blockquote class="font-serif text-lg italic leading-relaxed text-ink">
                  “{quote.text}”
                </blockquote>
                <p class="mt-2 text-ink group-hover:text-leather">{quote.book.data.title}</p>
                <p class="text-sm text-ink-soft">
                  {quote.book.data.author}
                  {quote.page ? `, sayfa ${quote.page}` : ""}
                </p>
              </a>
              <ShareButtons url={absoluteUrl} title={quote.book.data.title} class="mt-3" />
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>
