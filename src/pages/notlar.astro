---
import BaseLayout from "../layouts/BaseLayout.astro";
import { getAllNotes } from "../lib/books";
import { withBase } from "../lib/url";
import { formatDateTR } from "../lib/reading";

const notes = await getAllNotes();
---

<BaseLayout title="Notlar" description="Kitaplar üzerine alınan kişisel notların kronolojik listesi.">
  <div class="mx-auto max-w-3xl px-5 py-10">
    <h1 class="font-serif text-3xl text-ink">Notlar</h1>
    <p class="mt-2 text-ink-soft">Toplam {notes.length} not.</p>

    {notes.length === 0 && <p class="mt-8 text-ink-soft">Henüz eklenmiş bir not yok.</p>}

    <ul class="mt-8 flex flex-col gap-6">
      {
        notes.map((note) => {
          const relativeUrl = `/kitaplar/${note.book.id}/#not-${note.index}`;
          const date = note.book.data.endDate ?? note.book.data.startDate;
          return (
            <li id={`not-${note.book.id}-${note.index}`} class="scroll-mt-24 border-l-2 border-rule pl-4">
              <p class="max-w-[68ch] text-ink">{note.text}</p>
              <a href={withBase(relativeUrl)} class="group mt-2 flex flex-wrap items-baseline justify-between gap-x-3 gap-y-0.5">
                <span class="text-sm text-ink-soft group-hover:text-leather">{note.book.data.title}</span>
                {date && <span class="text-xs text-ink-soft/70">{formatDateTR(date)}</span>}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>
