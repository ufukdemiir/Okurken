---
import BaseLayout from "../layouts/BaseLayout.astro";
import { computeStats } from "../lib/stats";
import { STATUS_LABELS_TR } from "../lib/books";
import { getPublishedPosts } from "../lib/blog";
import { withBase } from "../lib/url";

const stats = await computeStats();
const totalBlogPosts = (await getPublishedPosts()).length;

// Sitenin tüm istatistik grafiklerinde kullanılan TEK renk kaynağı — hepsi
// aynı aileden olduğu için grafikler birbirinden alakasız durmuyor.
const CHART_PALETTE = [
  "#6E3B22", // deri kahvesi
  "#223752", // lacivert
  "#A67C1E", // hardal
  "#2F4A3A", // koyu yeşil
  "#7A2E2E", // bordo
  "#5B3868", // mor
  "#3D5A6C", // çelik mavisi
  "#A65A2E", // tarçın
];

const genreDistributionWithColor = stats.genreDistribution.map((g, i) => ({
  ...g,
  color: CHART_PALETTE[i % CHART_PALETTE.length],
}));
const topGenre = stats.genreDistribution[0] ?? null;

const summaryCards = [
  { label: "Toplam kitap", value: String(stats.totalBooks) },
  { label: "Okunan sayfa", value: stats.totalPagesRead.toLocaleString("tr-TR") },
  { label: "Ort. sayfa / kitap", value: stats.averagePagesPerBook ? String(stats.averagePagesPerBook) : "—" },
  {
    label: "Ort. bitirme süresi",
    value: stats.averageDaysToFinish ? `${stats.averageDaysToFinish} gün` : "—",
  },
  { label: "Ortalama puan", value: stats.averageRating ? `${stats.averageRating}/10` : "—" },
  { label: "Farklı yazar", value: String(stats.distinctAuthorCount) },
];

const highlights = [
  stats.longestBook && {
    label: "En uzun kitap",
    book: stats.longestBook,
    metric: `${stats.longestBook.data.pageCount} sayfa`,
  },
  stats.shortestBook &&
    stats.shortestBook.id !== stats.longestBook?.id && {
      label: "En kısa kitap",
      book: stats.shortestBook,
      metric: `${stats.shortestBook.data.pageCount} sayfa`,
    },
  stats.fastestRead && {
    label: "En hızlı bitirilen",
    book: stats.fastestRead.book,
    metric: stats.fastestRead.days === 0 ? "Aynı gün" : `${stats.fastestRead.days} günde`,
  },
  stats.slowestRead &&
    stats.slowestRead.book.id !== stats.fastestRead?.book.id && {
      label: "En uzun süren okuma",
      book: stats.slowestRead.book,
      metric: `${stats.slowestRead.days} günde`,
    },
  stats.firstCompletedBook && {
    label: "İlk bitirilen kitap",
    book: stats.firstCompletedBook,
    metric: stats.firstCompletedBook.data.endDate
      ? new Intl.DateTimeFormat("tr-TR", { month: "long", year: "numeric" }).format(stats.firstCompletedBook.data.endDate)
      : "",
  },
  stats.mostRecentCompletedBook &&
    stats.mostRecentCompletedBook.id !== stats.firstCompletedBook?.id && {
      label: "En son bitirilen kitap",
      book: stats.mostRecentCompletedBook,
      metric: stats.mostRecentCompletedBook.data.endDate
        ? new Intl.DateTimeFormat("tr-TR", { month: "long", year: "numeric" }).format(
            stats.mostRecentCompletedBook.data.endDate,
          )
        : "",
    },
].filter((h): h is { label: string; book: (typeof stats.longestBook & {}); metric: string } => Boolean(h));

// JSON.stringify metotlarında Chart.js için gereken diziler.
const chartPayload = {
  genreLabels: stats.genreDistribution.map((g) => g.genre),
  genreValues: stats.genreDistribution.map((g) => g.count),
  genreColors: genreDistributionWithColor.map((g) => g.color),
  ratingLabels: stats.ratingHistogram.map((r) => String(r.rating)),
  ratingValues: stats.ratingHistogram.map((r) => r.count),
  monthLabels: stats.booksPerMonth.map((m) => m.label),
  monthValues: stats.booksPerMonth.map((m) => m.count),
  yearLabels: stats.booksPerYear.map((y) => y.label),
  yearValues: stats.booksPerYear.map((y) => y.count),
  ratingColor: CHART_PALETTE[0],
  monthColor: CHART_PALETTE[6],
  yearColor: CHART_PALETTE[2],
};
---

<BaseLayout title="İstatistikler" description="Okuma alışkanlıkları üzerine sayılar ve grafikler.">
  <div class="mx-auto max-w-4xl px-5 py-10">
    <h1 class="font-serif text-3xl text-ink">İstatistikler</h1>
    <p class="mt-2 text-ink-soft">Tüm veriler derleme anında (build-time) hesaplanır.</p>

    <!-- Genel özet -->
    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-3 md:grid-cols-6">
      {
        summaryCards.map((card) => (
          <div class="rounded-xl border border-rule bg-surface p-4">
            <p class="font-serif text-2xl text-ink">{card.value}</p>
            <p class="mt-1 text-sm text-ink-soft">{card.label}</p>
          </div>
        ))
      }
    </div>

    <!-- Zaman dilimleri -->
    <h2 class="mt-10 font-serif text-lg text-ink">Zaman dilimlerine göre</h2>
    <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        stats.timeWindows.map((w) => (
          <div class="rounded-xl border border-rule bg-surface p-4">
            <p class="text-sm text-ink-soft">{w.label}</p>
            <p class="mt-1 font-serif text-xl text-ink">{w.booksFinished} kitap</p>
            <p class="text-sm text-ink-soft">{w.pagesRead.toLocaleString("tr-TR")} sayfa</p>
          </div>
        ))
      }
    </div>

    <!-- Durum + tür/puan/aylık grafikleri -->
    <div class="mt-10 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-rule bg-surface p-4">
        <p class="mb-3 text-sm font-semibold text-ink">Durum dağılımı</p>
        <div>
          {
            Object.entries(stats.statusCounts).map(([status, count]) => (
              <div class="flex items-center justify-between border-b border-rule py-2 text-sm last:border-none">
                <span class="text-ink-soft">{STATUS_LABELS_TR[status as keyof typeof STATUS_LABELS_TR]}</span>
                <span class="text-ink">{count}</span>
              </div>
            ))
          }
        </div>
        <p class="mb-3 mt-4 border-t border-dashed border-rule pt-4 text-sm font-semibold text-ink">İçerik</p>
        <div>
          <div class="flex items-center justify-between border-b border-rule py-2 text-sm">
            <span class="text-ink-soft">Alıntı</span>
            <span class="text-ink">{stats.totalQuotes}</span>
          </div>
          <div class="flex items-center justify-between border-b border-rule py-2 text-sm">
            <span class="text-ink-soft">Not</span>
            <span class="text-ink">{stats.totalNotes}</span>
          </div>
          <div class="flex items-center justify-between border-b border-rule py-2 text-sm">
            <span class="text-ink-soft">İnceleme</span>
            <span class="text-ink">{stats.totalReviews}</span>
          </div>
          <div class="flex items-center justify-between py-2 text-sm">
            <span class="text-ink-soft">Blog yazısı</span>
            <span class="text-ink">{totalBlogPosts}</span>
          </div>
        </div>
      </div>
      <div class="rounded-xl border border-rule bg-surface p-4">
        <p class="mb-3 text-sm font-semibold text-ink">Tür dağılımı</p>
        <canvas id="chart-genre" height="220" role="img" aria-label="Tür dağılımı grafiği"></canvas>
        {
          genreDistributionWithColor.length > 0 && (
            <ul class="mt-5 flex flex-wrap justify-center gap-x-4 gap-y-2 border-t border-rule pt-4">
              {genreDistributionWithColor.map((g) => (
                <li class="flex items-center gap-2 text-sm">
                  <span
                    class="size-2.5 shrink-0 rounded-full"
                    style={`background-color:${g.color}`}
                    aria-hidden="true"
                  />
                  <span class="text-ink-soft">{g.genre}</span>
                  <span class="text-ink-soft/70">{g.count}</span>
                </li>
              ))}
            </ul>
          )
        }
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-rule bg-surface p-4">
        <p class="mb-3 text-sm font-semibold text-ink">Puan dağılımı (1-10)</p>
        <canvas id="chart-rating" height="220" role="img" aria-label="Puan dağılımı grafiği"></canvas>
      </div>
      <div class="rounded-xl border border-rule bg-surface p-4">
        <p class="mb-3 text-sm font-semibold text-ink">Aylık bitirilen kitap sayısı</p>
        <canvas id="chart-monthly" height="220" role="img" aria-label="Aylık okuma grafiği"></canvas>
      </div>
    </div>

    <div class="mt-4 rounded-xl border border-rule bg-surface p-4">
      <p class="mb-3 text-sm font-semibold text-ink">Yıllara göre bitirilen kitap sayısı</p>
      <canvas id="chart-yearly" height="120" role="img" aria-label="Yıllara göre okuma grafiği"></canvas>
    </div>

    <!-- Öne çıkanlar -->
    {
      highlights.length > 0 && (
        <>
          <h2 class="mt-10 font-serif text-lg text-ink">Öne çıkanlar</h2>
          <div class="mt-4 grid grid-cols-2 gap-4 sm:grid-cols-4">
            {highlights.map((h) => (
              <a
                href={withBase(`/kitaplar/${h.book!.id}/`)}
                class="group rounded-xl border border-rule bg-surface p-4 transition-colors hover:border-leather"
              >
                <p class="text-sm text-ink-soft">{h.label}</p>
                <p class="mt-1 font-serif text-base text-ink group-hover:text-leather line-clamp-2">
                  {h.book!.data.title}
                </p>
                <p class="text-sm text-ink-soft">{h.metric}</p>
              </a>
            ))}
            {stats.mostReadAuthor && (
              <a
                href={withBase(`/yazarlar/${stats.mostReadAuthor.slug}/`)}
                class="group rounded-xl border border-rule bg-surface p-4 transition-colors hover:border-leather"
              >
                <p class="text-sm text-ink-soft">En çok okunan yazar</p>
                <p class="mt-1 font-serif text-base text-ink group-hover:text-leather line-clamp-2">
                  {stats.mostReadAuthor.name}
                </p>
                <p class="text-sm text-ink-soft">{stats.mostReadAuthor.count} kitap</p>
              </a>
            )}
            {topGenre && (
              <a
                href={withBase("/kitaplar/")}
                class="group rounded-xl border border-rule bg-surface p-4 transition-colors hover:border-leather"
              >
                <p class="text-sm text-ink-soft">En popüler tür</p>
                <p class="mt-1 font-serif text-base text-ink group-hover:text-leather line-clamp-2">
                  {topGenre.genre}
                </p>
                <p class="text-sm text-ink-soft">{topGenre.count} kitap</p>
              </a>
            )}
          </div>
        </>
      )
    }

    <!-- En'ler -->
    <h2 class="mt-10 font-serif text-lg text-ink">En'ler</h2>
    <p class="mt-1 text-sm text-ink-soft">
      Eşit değerlerde en son bitirilen kitap önce gösterilir.
    </p>
    <div class="mt-4 grid gap-6 sm:grid-cols-3">
      <div>
        <h3 class="font-serif text-base text-ink">En yüksek puanlılar</h3>
        <ul class="mt-3 flex flex-col gap-2">
          {
            stats.topRated.items.map((book) => (
              <li>
                <a href={withBase(`/kitaplar/${book.id}/`)} class="text-sm text-ink-soft hover:text-leather">
                  {book.data.title} ({book.data.rating}/10)
                </a>
              </li>
            ))
          }
        </ul>
        {stats.topRated.hasMore && (
          <a href={withBase("/kitaplar/")} class="mt-2 inline-block text-xs text-ink-soft hover:text-leather">
            +{stats.topRated.totalCount - stats.topRated.items.length} kitap daha — tümünü gör
          </a>
        )}
      </div>
      <div>
        <h3 class="font-serif text-base text-ink">En çok alıntılananlar</h3>
        <ul class="mt-3 flex flex-col gap-2">
          {
            stats.mostQuoted.items.map((book) => (
              <li>
                <a href={withBase(`/kitaplar/${book.id}/`)} class="text-sm text-ink-soft hover:text-leather">
                  {book.data.title} ({book.data.quotes.length})
                </a>
              </li>
            ))
          }
        </ul>
        {stats.mostQuoted.hasMore && (
          <a href={withBase("/alintilar/")} class="mt-2 inline-block text-xs text-ink-soft hover:text-leather">
            +{stats.mostQuoted.totalCount - stats.mostQuoted.items.length} kitap daha — tümünü gör
          </a>
        )}
      </div>
      <div>
        <h3 class="font-serif text-base text-ink">En çok not alınanlar</h3>
        <ul class="mt-3 flex flex-col gap-2">
          {
            stats.mostNoted.items.map((book) => (
              <li>
                <a href={withBase(`/kitaplar/${book.id}/`)} class="text-sm text-ink-soft hover:text-leather">
                  {book.data.title} ({book.data.notes.length})
                </a>
              </li>
            ))
          }
        </ul>
        {stats.mostNoted.hasMore && (
          <a href={withBase("/notlar/")} class="mt-2 inline-block text-xs text-ink-soft hover:text-leather">
            +{stats.mostNoted.totalCount - stats.mostNoted.items.length} kitap daha — tümünü gör
          </a>
        )}
      </div>
    </div>
  </div>
</BaseLayout>

<!-- Chart.js'e aktarılacak veriler: derleme anında hesaplanıp JSON olarak
     gömülür, ardından aşağıdaki GERÇEK (bundle edilen) modül betiği bunu okur. -->
<script type="application/json" id="stats-payload" set:html={JSON.stringify(chartPayload)} />

<script>
  import Chart from "chart.js/auto";

  interface ChartPayload {
    genreLabels: string[];
    genreValues: number[];
    genreColors: string[];
    ratingLabels: string[];
    ratingValues: number[];
    monthLabels: string[];
    monthValues: number[];
    yearLabels: string[];
    yearValues: number[];
    ratingColor: string;
    monthColor: string;
    yearColor: string;
  }

  const payloadEl = document.getElementById("stats-payload");
  const payload: ChartPayload = JSON.parse(payloadEl?.textContent ?? "{}");
  const {
    genreLabels,
    genreValues,
    genreColors,
    ratingLabels,
    ratingValues,
    monthLabels,
    monthValues,
    yearLabels,
    yearValues,
    ratingColor,
    monthColor,
    yearColor,
  } = payload;

  const styles = getComputedStyle(document.documentElement);
  const cssVar = (name: string) => styles.getPropertyValue(name).trim() || "#999999";
  const rule = cssVar("--color-rule");

  Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
  Chart.defaults.color = cssVar("--color-ink-soft");

  const genreCanvas = document.getElementById("chart-genre") as HTMLCanvasElement | null;
  if (genreCanvas && genreLabels?.length) {
    new Chart(genreCanvas, {
      type: "doughnut",
      data: {
        labels: genreLabels,
        datasets: [
          {
            data: genreValues,
            backgroundColor: genreColors,
            borderColor: "transparent",
          },
        ],
      },
      options: {
        // Kendi açıklamamızı (renk + tür adı + sayı) grafiğin altında ayrı
        // bir listede gösteriyoruz; Chart.js'in dahili legend'ı kapalı.
        plugins: { legend: { display: false } },
      },
    });
  }

  const ratingCanvas = document.getElementById("chart-rating") as HTMLCanvasElement | null;
  if (ratingCanvas) {
    new Chart(ratingCanvas, {
      type: "bar",
      data: {
        labels: ratingLabels,
        datasets: [{ data: ratingValues, backgroundColor: ratingColor }],
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: rule } },
        },
      },
    });
  }

  const monthlyCanvas = document.getElementById("chart-monthly") as HTMLCanvasElement | null;
  if (monthlyCanvas) {
    new Chart(monthlyCanvas, {
      type: "bar",
      data: {
        labels: monthLabels,
        datasets: [{ data: monthValues, backgroundColor: monthColor }],
      },
      options: {
        plugins: { legend: { display: false } },
        scales: {
          x: { grid: { display: false } },
          y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: rule } },
        },
      },
    });
  }

  const yearlyCanvas = document.getElementById("chart-yearly") as HTMLCanvasElement | null;
  if (yearlyCanvas && yearLabels?.length) {
    new Chart(yearlyCanvas, {
      type: "bar",
      data: {
        labels: yearLabels,
        datasets: [{ data: yearValues, backgroundColor: yearColor }],
      },
      options: {
        indexAxis: "y",
        plugins: { legend: { display: false } },
        scales: {
          x: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: rule } },
          y: { grid: { display: false } },
        },
      },
    });
  }
</script>
