---
import BaseLayout from "../layouts/BaseLayout.astro";
import { computeStats } from "../lib/stats";
import { STATUS_LABELS_TR } from "../lib/books";
import { withBase } from "../lib/url";

const stats = await computeStats();

const genreLabels = stats.genreDistribution.map((g) => g.genre);
const genreValues = stats.genreDistribution.map((g) => g.count);
const ratingLabels = stats.ratingHistogram.map((r) => String(r.rating));
const ratingValues = stats.ratingHistogram.map((r) => r.count);
const monthLabels = stats.booksPerMonth.map((m) => m.label);
const monthValues = stats.booksPerMonth.map((m) => m.count);

const summaryCards = [
  { label: "Toplam kitap", value: String(stats.totalBooks) },
  { label: "Okunan sayfa", value: stats.totalPagesRead.toLocaleString("tr-TR") },
  { label: "Ort. sayfa / kitap", value: stats.averagePagesPerBook ? String(stats.averagePagesPerBook) : "—" },
  {
    label: "Ort. bitirme süresi",
    value: stats.averageDaysToFinish ? `${stats.averageDaysToFinish} gün` : "—",
  },
];
---

<BaseLayout title="İstatistikler" description="Okuma alışkanlıkları üzerine sayılar ve grafikler.">
  <div class="mx-auto max-w-4xl px-5 py-10">
    <h1 class="font-serif text-3xl text-ink">İstatistikler</h1>
    <p class="mt-2 text-ink-soft">Tüm veriler derleme anında (build-time) hesaplanır.</p>

    <div class="mt-8 grid grid-cols-2 gap-4 sm:grid-cols-4">
      {
        summaryCards.map((card) => (
          <div class="rounded-xl border border-rule bg-surface p-4">
            <p class="font-serif text-2xl text-ink">{card.value}</p>
            <p class="mt-1 text-sm text-ink-soft">{card.label}</p>
          </div>
        ))
      }
    </div>

    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-rule bg-surface p-4">
        {
          Object.entries(stats.statusCounts).map(([status, count]) => (
            <div class="flex items-center justify-between border-b border-rule py-2 text-sm last:border-none">
              <span class="text-ink-soft">{STATUS_LABELS_TR[status as keyof typeof STATUS_LABELS_TR]}</span>
              <span class="text-ink">{count}</span>
            </div>
          ))
        }
      </div>
      <div class="rounded-xl border border-rule bg-surface p-4">
        <p class="mb-2 text-sm text-ink-soft">Tür dağılımı</p>
        <canvas id="chart-genre" height="220" role="img" aria-label="Tür dağılımı grafiği"></canvas>
      </div>
    </div>

    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      <div class="rounded-xl border border-rule bg-surface p-4">
        <p class="mb-2 text-sm text-ink-soft">Puan dağılımı (1-10)</p>
        <canvas id="chart-rating" height="220" role="img" aria-label="Puan dağılımı grafiği"></canvas>
      </div>
      <div class="rounded-xl border border-rule bg-surface p-4">
        <p class="mb-2 text-sm text-ink-soft">Aylık bitirilen kitap sayısı</p>
        <canvas id="chart-monthly" height="220" role="img" aria-label="Aylık okuma grafiği"></canvas>
      </div>
    </div>

    <div class="mt-8 grid gap-6 sm:grid-cols-3">
      <div>
        <h2 class="font-serif text-lg text-ink">En yüksek puanlılar</h2>
        <ul class="mt-3 flex flex-col gap-2">
          {
            stats.topRated.map((book) => (
              <li>
                <a href={withBase(`/kitaplar/${book.id}/`)} class="text-sm text-ink-soft hover:text-leather">
                  {book.data.title} ({book.data.rating}/10)
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-serif text-lg text-ink">En çok alıntılananlar</h2>
        <ul class="mt-3 flex flex-col gap-2">
          {
            stats.mostQuoted.map((book) => (
              <li>
                <a href={withBase(`/kitaplar/${book.id}/`)} class="text-sm text-ink-soft hover:text-leather">
                  {book.data.title} ({book.data.quotes.length})
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <div>
        <h2 class="font-serif text-lg text-ink">En çok not alınanlar</h2>
        <ul class="mt-3 flex flex-col gap-2">
          {
            stats.mostNoted.map((book) => (
              <li>
                <a href={withBase(`/kitaplar/${book.id}/`)} class="text-sm text-ink-soft hover:text-leather">
                  {book.data.title} ({book.data.notes.length})
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</BaseLayout>

<script
  define:vars={{
    genreLabels,
    genreValues,
    ratingLabels,
    ratingValues,
    monthLabels,
    monthValues,
  }}
>
  import("chart.js/auto").then(({ default: Chart }) => {
    const styles = getComputedStyle(document.documentElement);
    const cssVar = (name) => styles.getPropertyValue(name).trim() || "#999999";
    const palette = [
      cssVar("--color-leather"),
      cssVar("--color-teal"),
      cssVar("--color-gold"),
      cssVar("--color-ink-soft"),
      cssVar("--color-leather-soft"),
      cssVar("--color-teal-soft"),
      cssVar("--color-gold-soft"),
    ];
    const rule = cssVar("--color-rule");

    Chart.defaults.font.family = "'Plus Jakarta Sans', sans-serif";
    Chart.defaults.color = cssVar("--color-ink-soft");

    const genreCanvas = document.getElementById("chart-genre");
    if (genreCanvas && genreLabels.length) {
      new Chart(genreCanvas, {
        type: "doughnut",
        data: {
          labels: genreLabels,
          datasets: [
            {
              data: genreValues,
              backgroundColor: genreLabels.map((_, i) => palette[i % palette.length]),
              borderColor: "transparent",
            },
          ],
        },
        options: {
          plugins: { legend: { position: "bottom", labels: { boxWidth: 10 } } },
        },
      });
    }

    const ratingCanvas = document.getElementById("chart-rating");
    if (ratingCanvas) {
      new Chart(ratingCanvas, {
        type: "bar",
        data: {
          labels: ratingLabels,
          datasets: [{ data: ratingValues, backgroundColor: cssVar("--color-leather") }],
        },
        options: {
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: rule } },
          },
        },
      });
    }

    const monthlyCanvas = document.getElementById("chart-monthly");
    if (monthlyCanvas) {
      new Chart(monthlyCanvas, {
        type: "bar",
        data: {
          labels: monthLabels,
          datasets: [{ data: monthValues, backgroundColor: cssVar("--color-teal") }],
        },
        options: {
          plugins: { legend: { display: false } },
          scales: {
            x: { grid: { display: false } },
            y: { beginAtZero: true, ticks: { precision: 0 }, grid: { color: rule } },
          },
        },
      });
    }
  });
</script>
