---
import BaseLayout from "../layouts/BaseLayout.astro";
import StatusBadge from "../components/StatusBadge.astro";
import { getBooksWithReviews } from "../lib/books";
import { withBase } from "../lib/url";
import { estimateReadingMinutes, excerptFromMarkdown, formatDateTR } from "../lib/reading";

const books = await getBooksWithReviews();
const items = books.map((book) => ({
  book,
  excerpt: excerptFromMarkdown(book.body ?? ""),
  minutes: estimateReadingMinutes(book.body ?? ""),
}));
---

<BaseLayout title="İncelemeler" description="Okunan kitaplara dair kişisel incelemelerin tamamı.">
  <div class="mx-auto max-w-3xl px-5 py-10">
    <h1 class="font-serif text-3xl text-ink">İncelemeler</h1>
    <p class="mt-2 text-ink-soft">Toplam {items.length} inceleme.</p>

    <ul class="mt-8 flex flex-col divide-y divide-rule">
      {
        items.map(({ book, excerpt, minutes }) => {
          const date = book.data.endDate ?? book.data.startDate;
          return (
            <li class="py-8 first:pt-0">
              <a href={withBase(`/kitaplar/${book.id}/#inceleme`)} class="group block">
                <div class="flex flex-wrap items-baseline justify-between gap-x-3 gap-y-1">
                  <h2 class="font-serif text-xl text-ink group-hover:text-leather">{book.data.title}</h2>
                  <span class="text-sm text-ink-soft">{minutes} dk okuma süresi</span>
                </div>
                <p class="mt-1 text-sm text-ink-soft">{book.data.author}</p>
                <p class="prose-okurken mt-3 max-w-[68ch] text-ink-soft">{excerpt}</p>
              </a>
              <div class="mt-3 flex items-center gap-3 text-sm text-ink-soft">
                <StatusBadge status={book.data.status} />
                {date && <span>{formatDateTR(date)}</span>}
              </div>
            </li>
          );
        })
      }
    </ul>
  </div>
</BaseLayout>
