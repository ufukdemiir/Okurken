---
import { render, getEntry } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import ShareButtons from "../../components/ShareButtons.astro";
import { getPublishedPosts } from "../../lib/blog";
import { withBase } from "../../lib/url";
import { estimateReadingMinutes, excerptFromMarkdown, formatDateTR } from "../../lib/reading";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, publishDate, tags, excerpt } = post.data;

const settings = await getEntry("settings", "main");
const readerName = settings?.data.readerName ?? "Ufuk Demir";

const bodyText = post.body ?? "";
const readingMinutes = estimateReadingMinutes(bodyText);
const description = excerpt || excerptFromMarkdown(bodyText, 160);
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();

const structuredData = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: title,
  author: { "@type": "Person", name: readerName },
  datePublished: publishDate.toISOString().slice(0, 10),
  ...(tags.length ? { keywords: tags.join(", ") } : {}),
};
---

<BaseLayout title={title} description={description} ogType="article" structuredData={structuredData}>
  <article class="mx-auto max-w-3xl px-5 py-10">
    <a href={withBase("/blog/")} class="text-sm text-ink-soft hover:text-leather">← Bloga dön</a>

    <header class="mt-6">
      <h1 class="font-serif text-3xl leading-tight text-ink">{title}</h1>
      <div class="mt-2 flex flex-wrap items-center gap-x-3 gap-y-1 text-sm text-ink-soft">
        <time datetime={publishDate.toISOString().slice(0, 10)}>{formatDateTR(publishDate)}</time>
        <span>{readingMinutes} dk okuma süresi</span>
      </div>
      {
        tags.length > 0 && (
          <ul class="mt-3 flex flex-wrap gap-2">
            {tags.map((tag) => (
              <li class="rounded-full border border-rule px-3 py-1 text-xs text-ink-soft">{tag}</li>
            ))}
          </ul>
        )
      }
      <ShareButtons url={pageUrl} title={title} class="mt-5" />
    </header>

    <div class="prose-okurken prose mt-8 max-w-[68ch] dark:prose-invert">
      <Content />
    </div>
  </article>
</BaseLayout>
