---
import BaseLayout from "../layouts/BaseLayout.astro";
import RandomButton from "../components/RandomButton.astro";
import { withBase } from "../lib/url";
---

<BaseLayout title="Sayfa bulunamadı" description="Aradığınız sayfa bulunamadı.">
  <div class="mx-auto flex max-w-lg flex-col items-center px-5 py-24 text-center">
    <p class="font-serif text-5xl text-ink">404</p>
    <h1 class="mt-4 font-serif text-2xl text-ink">Bu sayfa raflarda yok</h1>
    <p class="mt-2 text-ink-soft">Aradığınız sayfa taşınmış ya da hiç var olmamış olabilir.</p>
    <div class="mt-6 flex flex-wrap justify-center gap-3">
      <a href={withBase("/")} class="rounded-full border border-rule px-4 py-2 text-sm text-ink-soft hover:border-leather hover:text-leather">
        Ana sayfaya dön
      </a>
      <RandomButton />
    </div>
  </div>
</BaseLayout>
