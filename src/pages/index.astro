---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCard from "../components/BookCard.astro";
import ReadingChallenge from "../components/ReadingChallenge.astro";
import MonthlyWrapUp from "../components/MonthlyWrapUp.astro";
import RandomButton from "../components/RandomButton.astro";
import { withBase } from "../lib/url";
import { getCurrentlyReading, getRecentlyFinished } from "../lib/books";

const settings = await getEntry("settings", "main");
const readerName = settings?.data.readerName ?? "Ufuk Demir";
const tagline = settings?.data.tagline ?? "";
const bio = settings?.data.bio ?? "";
const social = settings?.data.social;
const hasSocialLinks = Boolean(social?.github || social?.linkedin || social?.pinterest);

const currentlyReading = await getCurrentlyReading();
const recentlyFinished = await getRecentlyFinished(8);
---

<BaseLayout title="Okurken" description={settings?.data.siteDescription ?? "Ufuk Demir'in kişisel okuma günlüğü."}>
  <div class="mx-auto max-w-5xl px-5 py-10">
    <!-- Okur karşılama kartı -->
    <section class="border-b border-rule pb-10">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h1 class="font-serif text-3xl text-ink">{readerName}</h1>
          <p class="mt-1 text-ink-soft">{tagline}</p>
        </div>

        {
          hasSocialLinks && (
            <div class="inline-flex divide-x divide-rule overflow-hidden rounded-full border border-rule">
              {social?.github && (
                <a
                  href={social.github}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="GitHub"
                  class="flex size-9 items-center justify-center text-ink-soft transition-colors hover:bg-paper hover:text-leather"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <line x1="6" y1="3" x2="6" y2="15" />
                    <circle cx="18" cy="6" r="3" />
                    <circle cx="6" cy="18" r="3" />
                    <path d="M18 9a9 9 0 0 1-9 9" />
                  </svg>
                </a>
              )}
              {social?.linkedin && (
                <a
                  href={social.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="LinkedIn"
                  class="flex size-9 items-center justify-center text-sm font-semibold text-ink-soft transition-colors hover:bg-paper hover:text-leather"
                >
                  in
                </a>
              )}
              {social?.pinterest && (
                <a
                  href={social.pinterest}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Pinterest"
                  class="flex size-9 items-center justify-center text-ink-soft transition-colors hover:bg-paper hover:text-leather"
                >
                  <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M12 21s-7-6.5-7-11a7 7 0 0 1 14 0c0 4.5-7 11-7 11Z" />
                    <circle cx="12" cy="10" r="2.5" />
                  </svg>
                </a>
              )}
            </div>
          )
        }
      </div>

      <p class="mt-3 max-w-[62ch] text-ink-soft">{bio}</p>

      <div class="mt-6 flex flex-wrap gap-2">
        <RandomButton kind="book" />
        <RandomButton kind="quote" />
        <RandomButton kind="review" />
        <RandomButton kind="note" />
      </div>
    </section>

    <section class="mt-10">
      <ReadingChallenge />
    </section>

    {
      currentlyReading.length > 0 && (
        <section class="mt-10" aria-labelledby="reading-now-heading">
          <h2 id="reading-now-heading" class="font-serif text-lg text-ink">
            Şu an okunuyor
          </h2>
          <div class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4">
            {currentlyReading.map((book) => (
              <BookCard book={book} />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-10">
      <MonthlyWrapUp />
    </div>

    {
      recentlyFinished.length > 0 && (
        <section class="mt-10" aria-labelledby="recent-heading">
          <div class="flex items-baseline justify-between gap-3">
            <h2 id="recent-heading" class="font-serif text-lg text-ink">
              Son bitirilenler
            </h2>
            <a href={withBase("/kitaplar/")} class="text-sm text-leather hover:underline">
              Tüm kitaplar
            </a>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4">
            {recentlyFinished.map((book) => (
              <BookCard book={book} />
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-10 border-t border-rule pt-8">
      <p class="text-sm text-ink-soft">
        Kitaplar, alıntılar, incelemeler ve notların tamamını tek bir zaman akışında görmek için <a href={withBase("/arsiv/")} class="text-leather hover:underline">arşive</a> göz atabilirsiniz.
      </p>
    </section>
  </div>
</BaseLayout>
