---
import { getEntry } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import BookCard from "../components/BookCard.astro";
import ReadingChallenge from "../components/ReadingChallenge.astro";
import MonthlyWrapUp from "../components/MonthlyWrapUp.astro";
import RandomButton from "../components/RandomButton.astro";
import { withBase } from "../lib/url";
import { getSpineColor } from "../lib/spine";
import { getCurrentlyReading, getRecentlyFinished } from "../lib/books";

const settings = await getEntry("settings", "main");
const readerName = settings?.data.readerName ?? "Ufuk Demir";
const avatarInitials = settings?.data.avatarInitials ?? "UD";
const tagline = settings?.data.tagline ?? "";
const bio = settings?.data.bio ?? "";
const avatarSpine = getSpineColor(readerName);
const social = settings?.data.social;

const socialLinks = [
  { href: social?.github, label: "GitHub", mark: "GH" },
  { href: social?.linkedin, label: "LinkedIn", mark: "in" },
  { href: social?.pinterest, label: "Pinterest", mark: "P" },
].filter((l): l is { href: string; label: string; mark: string } => Boolean(l.href));

const currentlyReading = await getCurrentlyReading();
const recentlyFinished = await getRecentlyFinished(8);
---

<BaseLayout title="Okurken" description={settings?.data.siteDescription ?? "Ufuk Demir'in kişisel okuma günlüğü."}>
  <div class="mx-auto max-w-5xl px-5 py-10">
    <!-- Okur karşılama kartı -->
    <section class="border-b border-rule pb-10">
      <div class="flex flex-col gap-6 sm:flex-row sm:items-start">
        <div
          class="spine-texture flex size-20 shrink-0 items-center justify-center rounded-md font-serif text-2xl shadow-[inset_0_1px_0_rgba(255,255,255,0.22),inset_0_-1px_0_rgba(0,0,0,0.22)]"
          style={`background-color:${avatarSpine.bg}; color:${avatarSpine.ink}`}
          aria-hidden="true"
        >
          {avatarInitials}
        </div>

        <div class="flex-1">
          <div class="flex flex-wrap items-start justify-between gap-x-4 gap-y-3">
            <div>
              <h1 class="font-serif text-3xl text-ink">{readerName}</h1>
              <p class="mt-1 text-ink-soft">{tagline}</p>
            </div>
            {
              socialLinks.length > 0 && (
                <div class="flex items-center gap-2">
                  {socialLinks.map((link) => (
                    <a
                      href={link.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-label={link.label}
                      class="grid size-8 place-items-center rounded-full border border-rule text-xs font-medium text-ink-soft transition-colors hover:border-leather hover:text-leather"
                    >
                      {link.mark}
                    </a>
                  ))}
                </div>
              )
            }
          </div>
          <p class="mt-3 max-w-[60ch] text-ink-soft">{bio}</p>
        </div>
      </div>

      <div class="mt-6 flex flex-wrap gap-2">
        <RandomButton kind="book" />
        <RandomButton kind="quote" />
        <RandomButton kind="review" />
        <RandomButton kind="note" />
      </div>
    </section>

    <section class="mt-10">
      <ReadingChallenge />
    </section>

    {
      currentlyReading.length > 0 && (
        <section class="mt-10" aria-labelledby="reading-now-heading">
          <h2 id="reading-now-heading" class="font-serif text-lg text-ink">
            Şu an okunuyor
          </h2>
          <div class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4">
            {currentlyReading.map((book) => (
              <BookCard book={book} />
            ))}
          </div>
        </section>
      )
    }

    <div class="mt-10">
      <MonthlyWrapUp />
    </div>

    {
      recentlyFinished.length > 0 && (
        <section class="mt-10" aria-labelledby="recent-heading">
          <div class="flex items-baseline justify-between gap-3">
            <h2 id="recent-heading" class="font-serif text-lg text-ink">
              Son bitirilenler
            </h2>
            <a href={withBase("/kitaplar/")} class="text-sm text-leather hover:underline">
              Tüm kitaplar
            </a>
          </div>
          <div class="mt-4 grid grid-cols-2 gap-5 sm:grid-cols-3 md:grid-cols-4">
            {recentlyFinished.map((book) => (
              <BookCard book={book} />
            ))}
          </div>
        </section>
      )
    }

    <section class="mt-10 border-t border-rule pt-8">
      <p class="text-sm text-ink-soft">
        Kitaplar, alıntılar, incelemeler ve notların tamamını tek bir zaman akışında görmek için <a href={withBase("/arsiv/")} class="text-leather hover:underline">arşive</a> göz atabilirsiniz.
      </p>
    </section>
  </div>
</BaseLayout>
